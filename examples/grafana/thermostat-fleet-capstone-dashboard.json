          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select to_timestamp(window_start_tick) as \"time\",\n  avg(case when metric = 'Table:device-registry:CumulativeEstimatedCost' then \"value\" end) as \"device-registry\",\n  avg(case when metric = 'Table:device-telemetry:CumulativeEstimatedCost' then \"value\" end) as \"device-telemetry\",\n  avg(case when metric = 'Table:device-commands:CumulativeEstimatedCost' then \"value\" end) as \"device-commands\",\n  avg(case when metric = 'Table:device-alerts:CumulativeEstimatedCost' then \"value\" end) as \"device-alerts\"\nfrom stochastacy_demo.trial_window_time_series\nwhere batch_id = '${batch_id}'\n  and scenario_id = '${scenarioId}'\n  and metric in (\n    'Table:device-registry:CumulativeEstimatedCost',\n    'Table:device-telemetry:CumulativeEstimatedCost',\n    'Table:device-commands:CumulativeEstimatedCost',\n    'Table:device-alerts:CumulativeEstimatedCost'\n  )\n  and window_size_seconds = cast('${windowSizeSeconds}' as integer)\ngroup by window_start_tick order by window_start_tick;",
          "refId": "A"
        }
      ],
      "title": "Cumulative Estimated Cost by Table",
      "type": "timeseries"
