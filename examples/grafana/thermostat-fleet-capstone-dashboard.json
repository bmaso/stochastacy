          "rawSql": "select\n  split_part(metric, ':', 2) as \"Table\",\n  avg(\"value\") as \"Mean Total Cost\"\nfrom stochastacy_demo.trial_summary\nwhere batch_id = '${batch_id}'\n  and scenario_id = '${scenarioId}'\n  and metric in (\n    'Table:device-registry:TotalEstimatedCost',\n    'Table:device-telemetry:TotalEstimatedCost',\n    'Table:device-commands:TotalEstimatedCost',\n    'Table:device-alerts:TotalEstimatedCost'\n  )\ngroup by metric\norder by split_part(metric, ':', 2);",
