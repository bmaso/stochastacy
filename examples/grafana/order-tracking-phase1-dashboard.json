        {
          "datasource": {
            "type": "postgres",
            "uid": "stochastacy-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with percentiles as (\n  select\n    tick,\n    avg(\"value\") as mean,\n    percentile_cont(0.05) within group (order by \"value\") as p5,\n    percentile_cont(0.25) within group (order by \"value\") as p25,\n    percentile_cont(0.75) within group (order by \"value\") as p75,\n    percentile_cont(0.95) within group (order by \"value\") as p95\n  from stochastacy_demo.trial_time_series\n  where batch_id = '${batch_id}'\n    and scenario_id = '${scenarioId}'\n    and metric = 'ReadCapacityUnits'\n  group by tick\n)\nselect\n  to_timestamp(tick) as \"time\",\n  mean as \"Mean\",\n  p95 as \"P95\",\n  p75 as \"P75\",\n  p25 as \"P25\",\n  p5 as \"P5\",\n  p95 as \"Band P95-P75\",\n  p75 as \"Band P75-P25\",\n  p25 as \"Band P25-P5\"\nfrom percentiles\norder by tick;",
          "refId": "A"
        }
      ],
      "title": "Read Capacity Units by Tick",
      "type": "timeseries"
