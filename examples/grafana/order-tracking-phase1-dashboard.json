      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "stochastacy-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  to_timestamp(mean_series.window_start_tick) as \"time\",\n  mean_series.\"value\" as \"Mean Storage Bytes\",\n  mean_series.\"value\" + stddev_series.\"value\" as \"Mean + StdDev\",\n  mean_series.\"value\" - stddev_series.\"value\" as \"Mean - StdDev\"\nfrom stochastacy_demo.aggregate_window_time_series mean_series\nleft join stochastacy_demo.aggregate_window_time_series stddev_series\n  on stddev_series.batch_id = mean_series.batch_id\n and stddev_series.scenario_id = mean_series.scenario_id\n and stddev_series.metric = mean_series.metric\n and stddev_series.window_size_seconds = mean_series.window_size_seconds\n and stddev_series.window_start_tick = mean_series.window_start_tick\n and stddev_series.statistic = 'stddev'\nwhere mean_series.batch_id = '${batch_id}'\n  and mean_series.scenario_id = '${scenarioId}'\n  and mean_series.metric = 'StorageBytes'\n  and mean_series.window_size_seconds = cast('${windowSizeSeconds}' as integer)\n  and mean_series.statistic = 'mean'\norder by mean_series.window_start_tick;",
          "refId": "A"
        }
